{
  "id": "com.jordanmansfield.tonal",
  "name": "Tonal",
  "version": "1.3.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://jordanmansfield.dev",
        "ws://127.0.0.1:51849",
        "ws://localhost:51849",
        "127.0.0.1",
        "localhost"
      ]
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    }
  },
  "entrypoints": [
    {
      "id": "tonal",
      "type": "panel",
      "label": {
        "default": "Tonal"
      },
      "minimumSize": {
        "width": 240,
        "height": 320
      },
      "maximumSize": {
        "width": 2000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 720
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}